{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "enabledManagers": [
    "mix",
    "github-actions",
    "asdf",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The esbuild binary that bundles the test assets",
      "managerFilePatterns": [
        "/^config/config\\.exs$/"
      ],
      "matchStrings": [
        "config :esbuild,\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "esbuild",
      "datasourceTemplate": "npm"
    }
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "minimumReleaseAge": "2 days",
  "automerge": false,
  "rangeStrategy": "replace",
  "ignorePaths": [
    ".tool-versions.oldest"
  ],
  "packageRules": [
    {
      "description": "Keep runtime updates together",
      "matchManagers": [
        "asdf"
      ],
      "groupName": "toolchain"
    },
    {
      "description": "Preserve Elixir's OTP build compatibility suffix",
      "matchManagers": [
        "asdf"
      ],
      "matchDepNames": [
        "elixir"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>otp-\\d+)$"
    },
    {
      "description": "Support Erlang's additional patch component",
      "matchManagers": [
        "asdf"
      ],
      "matchDepNames": [
        "erlang"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))?$"
    },
    {
      "description": "Preserve existing Mix support and propose wider ranges for new releases",
      "matchManagers": [
        "mix"
      ],
      "rangeStrategy": "widen"
    }
  ],
  "constraints": {
    "erlang": "29"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-6 * * 1"
    ]
  }
}
